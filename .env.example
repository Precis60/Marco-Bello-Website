# Postgres connection string used to store bookings.
# Works with any standard Postgres provider, e.g.:
# - Supabase: Project Settings > Database > Connection string ("Transaction" pooler, port 6543, recommended for serverless)
# - Neon: add the Neon integration from the Vercel Storage tab (sets this automatically)
DATABASE_URL=

# Stripe secret key (Developers > API keys in the Stripe dashboard).
# Use a test key (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (Developers > Webhooks > your endpoint).
# The endpoint URL to register with Stripe is: https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Admin token for the pricing manager at /admin/prices.
# Generate a long random string and keep it secret — anyone with this token
# can set daily prices for the rentals.
ADMIN_TOKEN=
