# Postgres connection string used to store bookings.
# Easiest path: in your Vercel project, add the "Neon" (Postgres) integration
# from the Storage tab — it will create this variable for you automatically.
DATABASE_URL=

# Stripe secret key (Developers > API keys in the Stripe dashboard).
# Use a test key (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (Developers > Webhooks > your endpoint).
# The endpoint URL to register with Stripe is: https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
